[24bcs059@mepcolinux ex1]$cat pgm2.c
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <stdlib.h>
int a[100], n;
int prime(int num) {
    int i;
    if (num < 2)
        return 0;
    for (i = 2; i <= num / 2; i++) {
        if (num % i == 0)
            return 0;
    }
    return 1;
}
int main() {
    printf("Enter the size of the array: ");
    scanf("%d", &n);
    printf("Enter the array elements:\n");
    int i;
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    pid_t p;
    p = fork();
    if (p == 0) {
       exit(0);
    }
    else {
       wait(NULL);
       printf("Prime no. in the array are:\n");
       for (i = 0; i < n; i++) {
           if (prime(a[i]))
               printf("%d ", a[i]);
        }
        printf("\n");
    }
    return 0;
}
