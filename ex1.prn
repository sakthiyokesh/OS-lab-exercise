[24bcs059@mepcolinux ex1]$cat pgm3.c
#include <stdio.h>
#include <unistd.h>
#include <string.h>
char str[100];
int main() {
    pid_t p2, p3;
    printf("Enter a String: ");
    fgets(str, sizeof(str), stdin);
    p2 = fork();
    if (p2 == 0) {
        int i, vowels = 0;
        for (i = 0; str[i] != '\0'; i++) {
            if (str[i] == 'a' || str[i] == 'e' ||
                str[i] == 'i' || str[i] == 'o' ||
                str[i] == 'u' || str[i] == 'A' ||
                str[i] == 'E' || str[i] == 'I' ||
                str[i] == 'O' || str[i] == 'U') {
                vowels++;
            }
        }
        printf("No. of vowels = %d\n", vowels);
    }
    else {
        p3 = fork();
        if (p3 == 0) {
            int i, special = 0;
            for (i = 0; str[i] != '\0'; i++) {
                if (!((str[i] >= 'A' && str[i] <= 'Z') ||
                      (str[i] >= 'a' && str[i] <= 'z') ||
                      (str[i] >= '0' && str[i] <= '9') ||
                      str[i] == ' ' || str[i] == '\n')) {
                    special++;
                }
            }
            printf("No. of special characters = %d\n", special);
        }
    }
    return 0;
}
